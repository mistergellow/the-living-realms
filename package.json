{
  "name": "the-living-realms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "playwright test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @realms/db generate",
    "db:migrate": "pnpm --filter @realms/db migrate",
    "db:seed": "pnpm --filter @realms/db seed",
    "sim": "tsx scripts/simulate-balance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
