# ---- The Living Realms: local environment ----
# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (infra/docker-compose.yml uses these defaults)
DATABASE_URL=postgres://realms:realms@localhost:5432/living_realms
# Used only by the integration tests (tables are truncated!)
TEST_DATABASE_URL=postgres://realms:realms@localhost:5432/living_realms_test

# Redis (pub/sub between server instances and the world worker, rate limiting)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# HTTP server
HOST=0.0.0.0
PORT=3000
# Browser origin(s) allowed to call the API / open WebSockets (comma separated)
WEB_ORIGIN=http://localhost:5173
# Set to true behind HTTPS in production
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Optional: serve the built frontend from the API server (production single-container)
# WEB_DIST_DIR=apps/web/dist

# Apply pending database migrations when server/worker start (safe with many instances)
MIGRATE_ON_START=true

# Game configuration
WORLD_SLUG=main
MAX_CHARACTERS_PER_ACCOUNT=5
# Admin tools (/admin): comma-separated account emails allowed to create items/abilities
# and give them to characters. Empty = nobody is admin.
ADMIN_EMAILS=

# World worker
WORLD_TICK_MS=5000
